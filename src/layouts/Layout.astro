---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  math?: boolean; // 需要 MathJax 的頁面(含公式的文章)才傳 true
}

const { title, description = '個人部落格', math = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://jaaaackielai.github.io/avatar-awkward-pixel.png" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>{title}</title>
    {math && (
      <script is:inline>
        window.MathJax = {
          tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']],
            displayMath: [['\\[', '\\]']],
            processEscapes: true,
          },
          options: {
            skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
          },
          startup: {
            typeset: false,
            ready: function () {
              MathJax.startup.defaultReady();
              window.renderMath = function (root) {
                var target = root || document.body;
                if (MathJax.typesetClear) MathJax.typesetClear([target]);
                return MathJax.typesetPromise([target]).catch(function (error) {
                  console.error('MathJax typeset failed:', error);
                });
              };
              window.renderMath();
            },
          },
        };
      </script>
      <script is:inline id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-chtml.js" integrity="sha384-AHAnt9ZhGeHIrydA1Kp1L7FN+2UosbF7RQg6C+9Is/a7kDpQ1684C2iH2VWil6r4" crossorigin="anonymous"></script>
    )}
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="fixed top-0 left-0 right-0 z-50 border-b backdrop-blur-sm" style="border-color: var(--border); background-color: var(--nav-bg);">
      <nav class="max-w-2xl mx-auto px-6 h-12 flex items-center justify-between">
        <a href="/" class="font-mono text-sm font-medium transition-colors duration-150" style="color: var(--text-1);">
          Jackie
        </a>
        <div class="flex items-center gap-6">
          <a href="/blog" class="nav-link">
            <span data-zh="部落格" data-en="Blog">Blog</span>
          </a>
          <!-- 語言切換：EN / 中 -->
          <button class="seg-ctrl seg-ctrl-lang" onclick="toggleLanguage()" aria-label="切換語言">
            <span class="seg-thumb"></span>
            <span class="seg-opt">EN</span>
            <span class="seg-opt">中</span>
          </button>

          <!-- 深淺模式切換：☀ / ☾ -->
          <button class="seg-ctrl seg-ctrl-theme" onclick="toggleTheme()" aria-label="切換深淺模式">
            <span class="seg-thumb"></span>
            <!-- 太陽：亮色模式 -->
            <span class="seg-opt">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10A5 5 0 0012 7z" />
              </svg>
            </span>
            <!-- 月亮：深色模式 -->
            <span class="seg-opt">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
              </svg>
            </span>
          </button>
        </div>
      </nav>
    </header>

    <main class="pt-12">
      <slot />
    </main>

    <footer class="mt-20 border-t py-6" style="border-color: var(--border);">
      <div class="max-w-2xl mx-auto px-6 text-center text-xs font-mono" style="color: var(--footer-text);">
        © 2026 Jackie
      </div>
    </footer>

    <script is:inline>
      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }

      function applyLanguage(lang) {
        document.querySelectorAll('[data-zh]').forEach(function (el) {
          el.textContent = el.getAttribute('data-' + lang);
        });
        document.documentElement.classList.toggle('lang-zh', lang === 'zh');
        localStorage.setItem('lang', lang);
        document.documentElement.lang = lang === 'zh' ? 'zh-TW' : 'en';
        if (window.renderMath) {
          window.renderMath();
        }
      }

      function toggleLanguage() {
        var current = localStorage.getItem('lang') || 'en';
        applyLanguage(current === 'en' ? 'zh' : 'en');
      }

      // Apply saved language on load. Static HTML is already English
      // (initial text equals data-en), so the default needs no rewrite.
      (function () {
        var lang = localStorage.getItem('lang') || 'en';
        if (lang !== 'en') applyLanguage(lang);
      })();
    </script>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jackie">
  <!-- Hero -->
  <section class="max-w-2xl mx-auto px-6 pt-20 pb-14">
    <div class="flex items-start gap-7">
      <!-- Avatar: pixel dissolve 交替 -->
      <div class="avatar-swap">
        <canvas class="avatar-canvas"></canvas>
        <div class="avatar-ring"></div>
      </div>

      <!-- 名字與簡介 -->
      <div class="flex-1 pt-1">
        <h1 class="text-[44px] font-light tracking-tight leading-none mb-2" style="color: var(--text-1);">Jackie</h1>
        <p class="text-sm tracking-wide mb-6" style="color: var(--text-4);"
           data-zh="努力成為優秀的軟體工程師"
           data-en="Striving to be an excellent software engineer">
          jobtitle
        </p>
        <p class="leading-[1.75] text-sm mb-8" style="color: var(--text-3);"
           data-zh="熱衷於探索 Agentic AI 系統的設計與應用，喜歡把複雜的技術概念整理成清晰的文章分享給更多人。"
           data-en="Passionate about exploring AI Agent systems and their applications. I enjoy breaking down complex technical concepts into clear, accessible articles.">
          Personality · Interest
        </p>
        <div class="flex gap-6">
          <a
            href="mailto:jackie333333355@gmail.com"
            class="text-sm flex items-center gap-1.5 transition-colors duration-150"
            style="color: var(--text-3);"
            onmouseover="this.style.color='var(--accent)'"
            onmouseout="this.style.color='var(--text-3)'"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email
          </a>
          <a
            href="https://github.com/jaaaackieLai"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm flex items-center gap-1.5 transition-colors duration-150"
            style="color: var(--text-3);"
            onmouseover="this.style.color='var(--text-1)'"
            onmouseout="this.style.color='var(--text-3)'"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-6 pb-24">
    <div class="border-t" style="border-color: var(--border);"></div>

    <!-- 工作經歷 -->
    <section class="mt-14 mb-14">
      <p class="section-label" data-zh="工作經歷" data-en="Experience">Experience</p>
  
    </section>

    <!-- 學歷 -->
    <section>
      <p class="section-label" data-zh="學歷" data-en="Education">Education</p>
      <div>
        <div class="row-item">
          <div class="flex items-baseline justify-between">
            <div>
              <p class="text-sm font-medium" style="color: var(--text-1);"
                 data-zh="國立台灣科技大學" data-en="National Taiwan University of Science and Technology">National Taiwan University of Science and Technology</p>
              <p class="text-xs mt-1" style="color: var(--text-4);"
                 data-zh="資訊工程學系 碩士" data-en="M.S. in Computer Science & Information Engineering">M.S. in Computer Science & Information Engineering</p>
            </div>
            <span class="text-[11px] font-mono" style="color: var(--text-5);">2024 – 2026</span>
          </div>
        </div>
        <div class="row-item">
          <div class="flex items-baseline justify-between">
            <div>
              <p class="text-sm font-medium" style="color: var(--text-1);"
                 data-zh="國立臺灣師範大學" data-en="National Taiwan Normal University">National Taiwan Normal University</p>
              <p class="text-xs mt-1" style="color: var(--text-4);"
                 data-zh="物理學系 學士" data-en="B.S. in Physics">B.S. in Physics</p>
            </div>
            <span class="text-[11px] font-mono" style="color: var(--text-5);">2020 – 2024</span>
          </div>
        </div>
      </div>
    </section>
  </div>
<script>
  import '../scripts/avatar-dissolve.ts';
</script>
</Layout>

<style>
  .avatar-swap {
    position: relative;
    width: 180px;
    height: 180px;
    flex-shrink: 0;
    border-radius: 9999px;
    overflow: hidden;
  }

  .avatar-canvas {
    display: block;
    width: 180px;
    height: 180px;
  }

  /* 圓形邊框 overlay，疊在 canvas 上 */
  .avatar-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1.5px solid var(--border);
    pointer-events: none;
  }
</style>

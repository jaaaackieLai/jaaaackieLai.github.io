---
import Layout from '../../../layouts/Layout.astro';

const articles = [
  {
    slug: 'claude-code-setup',
    title: { zh: 'Claude Code 初始化與設定', en: 'Claude Code Setup & Configuration' },
    date: '2026-06-20',
    readTime: { zh: '10 分鐘', en: '10 min' },
    desc: {
      zh: '介紹如何設定 Claude Code 以及我自己安裝了那些好用的工具。',
      en: 'How to set up Claude Code and the tools I personally installed to supercharge the workflow.',
    },
    tags: ['Claude Code', 'Setup', 'Tools'],
  },
  {
    slug: 'harness-engineering',
    title: { zh: 'Harness Engineering', en: 'Harness Engineering' },
    date: '2026-06-22',
    readTime: { zh: '15 分鐘', en: '15 min' },
    desc: {
      zh: '探討在當前已經有足夠好的 LLM 模型底下，我們如何「駕馭」LLM 來協助我們處理任務。',
      en: 'How to harness capable LLMs to reliably handle complex tasks, given the models are already good enough.',
    },
    tags: ['LLM', 'Prompt Engineering', 'Orchestration'],
  },
  {
    slug: 'loop-engineering',
    title: { zh: 'Loop Engineering', en: 'Loop Engineering' },
    date: '2026-06-24',
    readTime: { zh: '12 分鐘', en: '12 min' },
    desc: {
      zh: '分析如何創建一個閉合式循環讓 LLM 可以自主下指令、優化並完成長時間任務。',
      en: 'Designing closed-loop systems where an LLM autonomously issues commands, self-corrects, and completes long-horizon tasks.',
    },
    tags: ['Agentic Loop', 'Autonomy', 'Long-horizon Tasks'],
  },
];
---

<Layout title="Agentic AI — 部落格 — Jackie" description="探索 AI Agent 系統設計與 multi-agent 協作架構的系列文章">
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-20">
    <div class="mb-12">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm transition-colors mb-6 nav-link">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span data-zh="所有文章" data-en="All Posts">All Posts</span>
      </a>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h1 class="text-2xl font-semibold" style="color: var(--text-1);">Agentic AI</h1>
      </div>
      <p class="max-w-2xl leading-relaxed" style="color: var(--text-3);"
         data-zh="AI Agent 不只是更聰明的聊天機器人，而是能夠自主規劃、呼叫工具、並在複雜環境中完成任務的系統。這個系列整理了我對 Agentic AI 架構的理解與實踐心得。"
         data-en="AI Agents are not just smarter chatbots — they are systems that can autonomously plan, call tools, and complete tasks in complex environments. This series documents my understanding and hands-on experience with Agentic AI architectures.">
        AI Agent 不只是更聰明的聊天機器人，而是能夠自主規劃、呼叫工具、並在複雜環境中完成任務的系統。這個系列整理了我對 Agentic AI 架構的理解與實踐心得。
      </p>
    </div>

    <!-- 文章列表 -->
    <div>
      <p class="section-heading" data-zh="系列文章" data-en="Article Series">Article Series</p>
      <div class="space-y-4">
        {articles.map((article, index) => (
          <a href={`/blog/agentic-ai/${article.slug}`} class="article-card">
            <div class="flex items-start gap-4">
              <span class="text-2xl font-mono font-bold flex-shrink-0 mt-0.5" style="color: var(--text-5);">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4 mb-1.5">
                  <h2 class="font-medium leading-snug" style="color: var(--text-1);"
                      data-zh={article.title.zh} data-en={article.title.en}>{article.title.en}</h2>
                  <span class="flex-shrink-0 text-xs font-mono" style="color: var(--text-4);"
                        data-zh={article.readTime.zh} data-en={article.readTime.en}>{article.readTime.en}</span>
                </div>
                <p class="text-sm mb-2.5 leading-relaxed" style="color: var(--text-3);"
                   data-zh={article.desc.zh} data-en={article.desc.en}>{article.desc.en}</p>
                <div class="flex items-center justify-between">
                  <div class="flex flex-wrap gap-1.5">
                    {article.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <span class="text-xs font-mono" style="color: var(--text-4);">{article.date}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

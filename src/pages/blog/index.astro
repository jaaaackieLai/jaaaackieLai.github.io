---
import Layout from '../../layouts/Layout.astro';
import { topics } from '../../data/topics';
import { getArticleCount } from '../../lib/articles';

// topic 設定集中在 src/data/topics.ts;文章數由 src/lib/articles.ts 自動統計
// (markdown 文章 + legacy 文章),新增或刪除文章時自動更新。
---

<Layout title="部落格">
  <section class="max-w-2xl mx-auto px-6 pt-20 pb-24">
    <div class="mb-12">
      <p class="section-label" data-zh="所有文章" data-en="All Posts">All Posts</p>
    </div>

    <div>
      {topics.map((topic) => (
        <a href={`/blog/${topic.slug}`} class="blog-card flex items-start justify-between block">
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-3 mb-2">
              <h2 class="text-sm font-medium transition-colors duration-150 group-hover:opacity-70"
                  style="color: var(--text-1);">{topic.name}</h2>
              <span class="text-[11px] font-mono" style="color: var(--text-5);">
                {getArticleCount(topic.slug)}&nbsp;<span data-zh="篇" data-en="articles">articles</span>
              </span>
            </div>
            <p class="text-sm leading-[1.75] mb-3" style="color: var(--text-3);"
               data-zh={topic.card.desc.zh} data-en={topic.card.desc.en}>{topic.card.desc.en}</p>
            <div class="flex flex-wrap gap-1.5">
              {topic.card.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
          <svg class="blog-card-arrow w-3.5 h-3.5 flex-shrink-0 ml-4 mt-0.5"
               fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      ))}
    </div>
  </section>
</Layout>

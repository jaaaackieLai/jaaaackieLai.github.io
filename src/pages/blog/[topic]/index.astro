---
import Layout from '../../../layouts/Layout.astro';
import { topics } from '../../../data/topics';
import { articleUrl, getTopicArticles } from '../../../lib/articles';

// 每個 topic 自動生成一頁。header 讀 topics.ts,文章列表讀合併後的 metadata。
export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const articles = getTopicArticles(topic.slug);
---

<Layout title={`topic: ${topic.name}`} description={topic.desc.zh}>
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-20">
    <div class="mb-12">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm transition-colors mb-6 nav-link">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span data-zh="所有文章" data-en="All Posts">All Posts</span>
      </a>

      <div class="flex items-center gap-3 mb-4">
        <div class={`w-10 h-10 rounded-xl bg-gradient-to-br ${topic.gradient} flex items-center justify-center`}>
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={topic.iconPath} />
          </svg>
        </div>
        <h1 class="text-2xl font-semibold" style="color: var(--text-1);">{topic.name}</h1>
      </div>
      <p class="max-w-2xl leading-relaxed" style="color: var(--text-3);"
         data-zh={topic.desc.zh} data-en={topic.desc.en}>{topic.desc.en}</p>
    </div>

    <!-- 文章列表 -->
    <div>
      <p class="section-heading" data-zh="系列文章" data-en="Article Series">Article Series</p>
      <div class="space-y-4">
        {articles.map((article, index) => (
          <a href={articleUrl(article)} class="article-card">
            <div class="flex items-start gap-4">
              <span class="text-2xl font-mono font-bold flex-shrink-0 mt-0.5" style="color: var(--text-5);">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4 mb-1.5">
                  <h2 class="font-medium leading-snug" style="color: var(--text-1);"
                      data-zh={article.title.zh} data-en={article.title.en}>{article.title.en}</h2>
                  <span class="flex-shrink-0 text-xs font-mono" style="color: var(--text-4);"
                        data-zh={`${article.readTime} 分鐘`} data-en={`${article.readTime} min`}>{article.readTime} min</span>
                </div>
                {article.desc.zh && (
                  <p class="text-sm mb-2.5 leading-relaxed" style="color: var(--text-3);"
                     data-zh={article.desc.zh} data-en={article.desc.en}>{article.desc.en}</p>
                )}
                <div class="flex items-center justify-between">
                  <div class="flex flex-wrap gap-1.5">
                    {article.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <span class="text-xs font-mono" style="color: var(--text-4);">{article.date}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

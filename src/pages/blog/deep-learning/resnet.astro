---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="ResNet — Jackie">
  <section class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <div class="mb-10">
      <a href="/blog/deep-learning" class="inline-flex items-center gap-1.5 text-sm transition-colors mb-8"
         style="color: var(--text-4);" onmouseover="this.style.color='var(--text-2)'" onmouseout="this.style.color='var(--text-4)'">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Deep Learning
      </a>

      <p class="section-label">Deep Learning · 03</p>
      <h1 class="text-3xl font-light tracking-tight mb-4" style="color: var(--text-1);">
        ResNet
      </h1>

      <div class="flex items-center gap-4 mt-6 text-xs font-mono" style="color: var(--text-5);">
        <span>2026-06-27</span>
        <span>·</span>
        <span>— min</span>
      </div>
    </div>

    <div class="border-t pt-10" style="border-color: var(--border);">
      <!-- content -->
    </div>
  </section>
</Layout>

                <text x="144" y="84" class="flow-node-title">我 愛 貓</text>
                <text x="144" y="104" class="flow-node-subtitle">3 tokens</text>
              </g>

              <g class="flow-node" data-flow-target="1" role="button" tabindex="0" aria-label="Vectorize">
                <rect x="64" y="160" width="160" height="80" rx="6" class="flow-node-mask" />
                <rect x="64" y="160" width="160" height="80" rx="6" class="flow-node-box" />
                <rect x="76" y="172" width="44" height="16" rx="2" class="flow-node-tag" />
                <text x="98" y="184" class="flow-tag-text">VEC</text>
                <text x="144" y="204" class="flow-node-title" data-zh="Embedding + 位置" data-en="Embedding + Position">Embedding + Position</text>
                <text x="144" y="224" class="flow-node-subtitle">3 x 512</text>

  </style>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-transformer-flow]');
      if (!root) return;

      var steps = root.querySelectorAll('[data-flow-step]');
      var nodes = root.querySelectorAll('[data-flow-target]');
      var panels = root.querySelectorAll('[data-panel]');

      function setStep(step) {
        steps.forEach(function (button) {
          var active = button.getAttribute('data-step') === step;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        nodes.forEach(function (node) {
          node.classList.toggle('is-active', node.getAttribute('data-flow-target') === step);
        });

        panels.forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-panel') !== step;
        });
      }

      steps.forEach(function (button) {
        button.addEventListener('click', function () {
          setStep(button.getAttribute('data-step'));
        });
      });

      nodes.forEach(function (node) {
        node.addEventListener('click', function () {
          setStep(node.getAttribute('data-flow-target'));
        });
        node.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            setStep(node.getAttribute('data-flow-target'));
          }
        });
      });
    })();
  </script>
